#!/bin/sh
# Pre-push: runs `make test` (Android unit tests) before each git push.
# Enabled by `make hooks` (core.hooksPath). To skip it: git push --no-verify
set -e

cd "$(git rev-parse --show-toplevel)"

# same pattern as the Makefile: ANDROID_HOME ?= $(HOME)/Android/Sdk
sdk="${ANDROID_HOME:-$HOME/Android/Sdk}"
missing=""

if ! command -v java >/dev/null 2>&1; then
    missing="${missing}\n  - Java (JDK) on PATH"
fi
if [ ! -d "$sdk" ]; then
    missing="${missing}\n  - Android SDK at $sdk (or set ANDROID_HOME)"
fi
if [ -n "$missing" ]; then
    printf 'push blocked: the tests need:%b\n' "$missing" >&2
    printf 'to push without testing: git push --no-verify\n' >&2
    exit 1
fi

echo "pre-push: running make test..."
if ! make test; then
    echo "push blocked: tests failed. Fix them or use git push --no-verify." >&2
    exit 1
fi
